# ─── Database (Neon) ─────────────────────────────────────────
DATABASE_URL=postgresql://username:password@ep-xxxx.region.aws.neon.tech/portfolio?sslmode=require

# ─── Auth (NextAuth v5) ───────────────────────────────────────
# Generate AUTH_SECRET with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=your_auth_secret_here

# Single admin user credentials
ADMIN_EMAIL=admin@yourdomain.com

# Generate ADMIN_PASSWORD_HASH with bcrypt (rounds=12):
#   npm install -g bcryptjs
#   node -e "const b = require('bcryptjs'); b.hash('yourpassword', 12).then(console.log)"
# Or use https://bcrypt-generator.com (rounds: 12)
ADMIN_PASSWORD_HASH=$2b$12$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Cloudinary ──────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=portfolio_uploads

# ─── Email (Resend) ──────────────────────────────────────────
RESEND_API_KEY=re_xxxx
CONTACT_EMAIL=hello@yourdomain.com

# ─── Site ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
